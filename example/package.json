    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.1",
    "prisma": "^7.8.0",
    "typescript": "^7.0.2"
  }
}
